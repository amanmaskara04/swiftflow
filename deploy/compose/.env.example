# SwiftFlow - Docker Compose settings (local development defaults).
# Copy to deploy/compose/.env (gitignored). `swiftflow.ps1 up` does this for you.
# These are DEV-ONLY values. Never reuse them anywhere real.

ENVIRONMENT=local
LOG_LEVEL=INFO

# Postgres superuser (used only by init.sql, the seed CLI and the invariant checker)
POSTGRES_PASSWORD=swiftflow-dev-superuser
# One login role per service (created by postgres/init.sql on first start)
ORDER_DB_PASSWORD=order-svc-dev
INVENTORY_DB_PASSWORD=inventory-svc-dev
NOTIFICATION_DB_PASSWORD=notification-svc-dev

# Shared secret the order worker presents to the payment provider (partner-sim)
PROVIDER_API_KEY=dev-provider-key-change-me

# JWT
JWT_ISSUER=swiftflow-order
JWT_AUDIENCE=swiftflow
# Optional PEM (PKCS8 Ed25519). Empty = generate once and store in orders.signing_keys.
JWT_PRIVATE_KEY_PEM=
TOKEN_TTL_SECONDS=900

# Per-tenant token bucket
RATE_LIMIT_RPS=200
RATE_LIMIT_BURST=1000

# Demo clients shown on the console's sign-in screen (local only) and created by `seed`.
# Format: client_id:secret:role:Tenant Name, separated by semicolons.
DEMO_CLIENTS=acme-admin:acme-admin-secret:admin:Acme Outfitters;acme-partner:acme-partner-secret:partner:Acme Outfitters;globex-admin:globex-admin-secret:admin:Globex Supply

# Console origins allowed by the gateway's CORS policy
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Webhook SSRF allow-list (host:port). Development only.
WEBHOOK_ALLOWED_HOSTS=partner-sim:8004
WEBHOOK_ALLOW_HTTP=true

# Partner simulator defaults
DEFAULT_FAILURE_RATE=0
DEFAULT_LATENCY_MS=50

# Tracing: set to http://jaeger:4318 with the observability profile (`swiftflow.ps1 up -Observability`)
OTEL_EXPORTER_OTLP_ENDPOINT=

# Grafana admin password (observability profile)
GRAFANA_ADMIN_PASSWORD=admin
